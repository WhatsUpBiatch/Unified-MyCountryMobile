{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npx vite build --mode mock",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/captain-api/(.*)", "destination": "/api/__captain/$1" },
    { "source": "/((?!api/|captain-api/).*)", "destination": "/index.html" }
  ]
}
