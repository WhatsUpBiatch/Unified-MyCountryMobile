+    /**
+     * A person's seat in every queue of the company: mark it suspended, restore
+     * it exactly, or remove it. Called by default-api when a person is
+     * suspended / reactivated / removed / restored / purged. See
+     * services/queueMembership.ts for what each action does to the queue
+     * record, the agent row and the tier row. Queues are read one by one and
+     * each one is finished before the next, so a failure part-way leaves
+     * whole queues either done or untouched.
+     */
+    public static async setMemberState(request: IMemberState, userData: IUser): Promise<object> {
+        const { QueueModel, QueueAgentModel, QueueTierModel } = await this.getMainQueueModels();
+        const user_uuid = String(request?.user_uuid ?? "").trim();
+        const action = String(request?.action ?? "").trim() as any;
+        const reason = String(request?.reason ?? action);
+        if (!user_uuid) throw new HttpException(422, "user_uuid is required");
+        if (!MEMBERSHIP_ACTIONS.includes(action)) throw new HttpException(422, `action must be one of ${MEMBERSHIP_ACTIONS.join(", ")}`);
+        const companyId = String(userData?.company_uuid ?? "");
+        if (!companyId) throw new HttpException(401, "company is required");
+        const now = new Date();
+
+        const queues: any[] = await QueueModel.find({
+            company_uuid: companyId,
+            $or: [{ "members.user_uuid": user_uuid }, { "members.value": user_uuid }],
+        }).select("_id extension domain members").lean();
+
+        const summary = { action, user_uuid, queues_touched: 0, members_changed: 0, agents_changed: 0, tiers_changed: 0, queues: [] as string[] };
+        for (const queue of queues) {
+            const result = applyToMembers(queue.members, user_uuid, action, now, reason);
+            if (result.changed) {
+                await QueueModel.updateOne({ _id: queue._id, company_uuid: companyId }, { $set: { members: result.members } });
+                summary.members_changed += result.changed;
+            }
+
+            const domain = queue.domain || userData?.domain;
+            const extensions = Array.from(new Set(
+                result.matched.map((m: any) => String(m?.extension ?? "").trim()).concat(String(request?.extension ?? "").trim()).filter(Boolean),
+            ));
+            const agentFilter: Record<string, any> = { queue_uuid: queue._id, "user_detail.user_uuid": user_uuid };
+            const tierFilter: Record<string, any> = {
+                queue: agentName(queue.extension, domain),
+                agent: { $in: extensions.map((ext) => agentName(ext, domain)) },
+            };
+
+            const agentUpdate = agentUpdateFor(action, now, reason);
+            const agents = agentUpdate
+                ? await QueueAgentModel.updateMany(agentFilter, agentUpdate)
+                : await QueueAgentModel.deleteMany(agentFilter);
+            summary.agents_changed += Number(agents?.modifiedCount ?? agents?.deletedCount ?? 0);
+
+            if (extensions.length) {
+                const tierUpdate = tierUpdateFor(action, now, reason);
+                const tiers = tierUpdate
+                    ? await QueueTierModel.updateMany(tierFilter, tierUpdate)
+                    : await QueueTierModel.deleteMany(tierFilter);
+                summary.tiers_changed += Number(tiers?.modifiedCount ?? tiers?.deletedCount ?? 0);
+            }
+
+            summary.queues_touched++;
+            summary.queues.push(String(queue._id));
+        }
+
+        console.log(`QueueRepository.setMemberState ${action} ${user_uuid} (${reason}) company=${companyId}: ${summary.queues_touched} queue(s), ${summary.members_changed} member(s), ${summary.agents_changed} agent row(s), ${summary.tiers_changed} tier row(s)`);
+        return summary;
+    }
