# Permission tree enforcement (middlewares/PermissionGuard.ts).
#   report  (default, or unset) - log "would have refused", let the request through
#   enforce                     - answer 403 { message, permission }
# Leave unset for the first days on a live box; read the permissionGuard log
# lines (reason: missing vs refused) before switching to enforce.
PERMISSION_ENFORCE=report
