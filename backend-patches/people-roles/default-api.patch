+    /** Bring a removed person back, within the window. Administrators only. */
+    public async restore(req: IRequest, res: Response): Promise<object> {
+        const uuid = getString(req.params.uuid);
+        if (!uuid) return super.sendError(res, "Invalid user uuid");
+        const { company_uuid } = req.auth as IAuth;
+
+        const result = await DeletedUserService.restore(company_uuid, uuid);
+        if (!result.ok) {
+            return super.sendError(res, result.message, null, result.status);
+        }
+        return super.sendSuccess(res, "Person restored. Any call routing that pointed at them was not put back.", {
+            user: result.user,
+            licence: result.licence,
+        });
