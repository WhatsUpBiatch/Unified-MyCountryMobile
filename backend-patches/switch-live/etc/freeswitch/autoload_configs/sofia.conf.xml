<configuration name="sofia.conf" description="sofia Endpoint">

  <global_settings>
    <param name="log-level" value="0"/>
    <!-- <param name="auto-restart" value="false"/> -->
    <param name="capture-server" value="udp:127.0.0.1:9060;hep=3;capture_id=3001" />
    <param name="debug-presence" value="0"/>
  </global_settings>
  <profiles>
    <profile name="internal">
      <aliases>
      </aliases>
      <gateways>
          <gateway name="127.0.0.1">
            <param name="proxy" value="127.0.0.1"/>
            <param name="register" value="false"/>
            <param name="username" value="sipmedia"/>
            <param name="extension-in-contact" value="true"/>
            <param name="ping" value="20"/>
          </gateway>
      </gateways>

      <domains>
        <domain name="all" alias="true" parse="false"/>
      </domains>

      <settings>
        <param name="sip-capture" value="yes"/>
        <param name="sip-trace" value="no"/>
        <param name="sip-ip" value="127.0.0.1"/>
        <param name="rtp-ip" value="142.93.121.121"/>
        <param name="ext-sip-ip" value="127.0.0.1"/>
        <param name="ext-rtp-ip" value="142.93.121.121"/>
        <param name="local-network-acl" value=""/>
        <param name="sip-port" value="5066"/>
        <param name="session-timeout" value="600"/>
        <param name="context" value="internal"/>
        <param name="inbound-codec-prefs" value="$${global_codec_prefs}"/>
        <param name="outbound-codec-prefs" value="$${global_codec_prefs}"/>
        <param name="enable-timer" value="true"/>
        <param name="debug" value="0"/>
        <param name="log-auth-failures" value="false"/>
        <param name="liberal-dtmf" value="true"/>
        <param name="pass-rfc2833" value="true"/>
        <param name="rfc2833-pt" value="101"/>
        <param name="dtmf-type" value="rfc2833"/>
        <param name="dtmf-duration" value="2000"/>
        <param name="dialplan" value="XML"/>
        <param name="rtp-timer-name" value="soft"/>
        <param name="rtcp-audio-interval-msec" value="5000"/>
        <param name="hold-music" value="$${hold_music}"/>
        <param name="apply-candidate-acl" value="0.0.0.0/0"/>
        <!-- <param name="apply-candidate-acl" value="wan.auto"/> -->
        <param name="apply-nat-acl" value="nat.auto"/>
        <param name="apply-inbound-acl" value="sipcore"/>
        <param name="minimum-session-expires" value="90"/>
        <!-- P-*-Identity family of headers -->
        <param name="caller-id-type" value="pid"/>
        <param name="manage-presence" value="true"/>
        <param name="send-display-update" value="false"/>
        <param name="inbound-codec-negotiation" value="generous"/>
        <param name="inbound-zrtp-passthru" value="true"/>
        <param name="nonce-ttl" value="60"/>
        <param name="auth-calls" value="true"/>
        <param name="inbound-reg-force-matching-username" value="true"/>
        <param name="auth-all-packets" value="false"/>
        <param name="challenge-realm" value="auto_from"/>
      </settings>
    </profile>

    <profile name="inbound">
      <aliases>
      </aliases>
      <gateways>
      </gateways>

      <domains>
        <domain name="all" alias="true" parse="false"/>
      </domains>

      <settings>
        <param name="sip-capture" value="yes"/>
        <param name="sip-trace" value="no"/>
        <param name="sip-ip" value="127.0.0.1"/>
        <param name="rtp-ip" value="142.93.121.121"/>
        <param name="ext-sip-ip" value="127.0.0.1"/>
        <param name="ext-rtp-ip" value="142.93.121.121"/>
        <param name="local-network-acl" value=""/>
        <param name="sip-port" value="4066"/>
        <param name="session-timeout" value="600"/>
        <param name="context" value="public"/>
        <param name="inbound-codec-prefs" value="$${global_codec_prefs}"/>
        <param name="outbound-codec-prefs" value="$${global_codec_prefs}"/>
        <param name="enable-timer" value="true"/>
        <param name="debug" value="0"/>
        <param name="log-auth-failures" value="false"/>
        <param name="liberal-dtmf" value="true"/>
        <param name="pass-rfc2833" value="true"/>
        <param name="rfc2833-pt" value="101"/>
        <param name="dtmf-type" value="rfc2833"/>
        <param name="dtmf-duration" value="2000"/>
        <param name="dialplan" value="XML"/>
        <param name="rtp-timer-name" value="soft"/>
        <param name="rtcp-audio-interval-msec" value="5000"/>
        <param name="hold-music" value="$${hold_music}"/>
        <param name="apply-candidate-acl" value="wan.auto"/>
        <param name="apply-nat-acl" value="nat.auto"/>
        <param name="apply-inbound-acl" value="sipcore"/>
        <!-- <param name="minimum-session-expires" value="90"/> -->
        <!-- P-*-Identity family of headers -->
        <param name="caller-id-type" value="pid"/>
        <param name="manage-presence" value="false"/>
        <param name="send-display-update" value="false"/>
        <param name="inbound-codec-negotiation" value="generous"/>
        <param name="inbound-zrtp-passthru" value="true"/>
        <param name="nonce-ttl" value="60"/>
        <param name="auth-calls" value="true"/>
        <param name="inbound-reg-force-matching-username" value="true"/>
        <param name="auth-all-packets" value="false"/>
        <param name="challenge-realm" value="auto_from"/>
      </settings>
    </profile>

  </profiles>

</configuration>
