<configuration name="xml_curl.conf" description="cURL XML Gateway">
  <bindings>
    <binding name="dialplan">
      <param name="gateway-url" value="http://localhost:9000/v1/dialplan" bindings="dialplan"/>
      <param name="timeout" value="10"/>
    </binding>
    <binding name="directory">
      <param name="gateway-url" value="http://localhost:9001/v1/directory" bindings="directory"/>
      <param name="timeout" value="10"/>
    </binding>
    <binding name="configuration">
      <param name="gateway-url" value="http://localhost:9002/v1/configuration" bindings="configuration"/>
      <param name="timeout" value="10"/>
    </binding>
  </bindings>
</configuration>
