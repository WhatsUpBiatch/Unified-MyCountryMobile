[Unit]
Description=fs-xml-api
After=network.target nats-server.service

[Service]
Type=simple
WorkingDirectory=/opt/fs-xml-api-1.2.5
EnvironmentFile=/opt/fs-xml-api-1.2.5/.env
ExecStart=/usr/bin/python3 /opt/fs-xml-api-1.2.5/dialplan_service.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
