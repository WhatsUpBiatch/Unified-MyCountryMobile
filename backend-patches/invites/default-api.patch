+ */
+
+import { Model, DataTypes, Optional } from "sequelize";
+import { sequelize } from "../config/database";
+
+export interface IUserInvite {
+    id: number;
+    user_uuid: string;
+    company_uuid: string;
+    token_hash: string;
+    expires_at: Date;
+    accepted_at: Date | null;
+    created_by: string | null;
